<Window x:Class="WpfBeginner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event 실습"
        Height="500"
        Width="700">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Text="社員管理"
            FontSize="30"
            FontWeight="Bold"
            Margin="0,0,0,20"/>


        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,20">
            
            <TextBlock
                Text="名前: "
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>
            
            <TextBox
                x:Name="txtSearchName"
                Width="200"
                Height="30"
                Margin="0,0,10,0"/>
            
            <Button
                Content="検索"
                Width="80"
                Height="30"
                Click="SearchButton_Click"/>
            
            <Button
                Content="全体"
                Width="80"
                Height="30"
                Click="ShowAllButton_Click"/>
        </StackPanel>

        <DataGrid
            x:Name="dgEmployees"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionChanged="EmployeeDataGrid_SelectionChanged">

            <DataGrid.Columns>
                
                <DataGridTextColumn
                    Header="ID"
                    Binding="{Binding Id}"
                    Width="80"/>
                
                <DataGridTextColumn
                    Header="名前"
                    Binding="{Binding Name}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="年齢"
                    Binding="{Binding Age}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="部署"
                    Binding="{Binding Department}"
                    Width="120"/>

            </DataGrid.Columns>
            
        </DataGrid>

        <TextBlock
            x:Name="txtSelectedEmployee"
            Grid.Row="3"
            FontSize="20"
            FontWeight="Bold"
            Text="Selected Employee: ">
        </TextBlock>

    </Grid>

</Window>
