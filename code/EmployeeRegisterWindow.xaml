<Window x:Class="WpfApp1.EmployeeRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="EmployeeRegisterWindow" Height="350" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="社員登録"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20">
        </TextBlock>
        
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="名前:"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="5">
        </TextBlock>

        <TextBox
            x:Name="txtName"
            Grid.Row="1"
            Grid.Column="1"
            Height="30"
            Margin="5">
        </TextBox>
        
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Text="部署:"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="5">
        </TextBlock>
        
        <ComboBox
            x:Name="cmbDepartment"
            Grid.Row="2"
            Grid.Column="1"
            Height="30"
            Margin="5"
            SelectedIndex="0">
            <ComboBoxItem>営業部</ComboBoxItem>
            <ComboBoxItem>人事部</ComboBoxItem>
            <ComboBoxItem>総務部</ComboBoxItem>
        </ComboBox>

        <!-- 재직 여부 -->
        <CheckBox
            x:Name="chkActive"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Content="재직 중"
            IsChecked="True"
            Margin="5,15,5,5"/>

        <!-- 버튼 -->
        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,25,0,0">

            <Button
                Content="저장"
                Width="80"
                Height="35"
                Margin="5"
                Click="SaveButton_Click"/>

            <Button
                Content="취소"
                Width="80"
                Height="35"
                Margin="5"
                Click="CancelButton_Click"/>

        </StackPanel>


    </Grid>
</Window>
