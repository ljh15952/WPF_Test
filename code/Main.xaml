<Window x:Class="WpfBeginner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event 실습"
        Height="450"
        Width="500"
        Loaded="Window_Loaded">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 제목 -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="Event 실습 - 사원 정보"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,25"/>

        <!-- 이름 -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="이름"
            VerticalAlignment="Center"/>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1">

            <TextBox
                x:Name="txtName"
                Height="30"
                MaxLength="10"
                TextChanged="NameTextBox_TextChanged"/>

            <TextBlock
                x:Name="txtNameLength"
                Text="입력 글자: 0 / 10"
                HorizontalAlignment="Right"
                Margin="0,5,0,10"/>

        </StackPanel>

        <!-- 부서 -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Text="부서"
            VerticalAlignment="Center"/>

        <ComboBox
            x:Name="cmbDepartment"
            Grid.Row="2"
            Grid.Column="1"
            Height="30"
            Margin="0,5,0,15"
            SelectionChanged="DepartmentComboBox_SelectionChanged">

            <ComboBoxItem Content="개발부"/>
            <ComboBoxItem Content="영업부"/>
            <ComboBoxItem Content="총무부"/>
            <ComboBoxItem Content="시스템부"/>

        </ComboBox>

        <!-- 재직 여부 -->
        <CheckBox
            x:Name="chkActive"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Content="재직 중"
            Margin="0,5,0,20"
            Checked="ActiveCheckBox_Checked"
            Unchecked="ActiveCheckBox_Unchecked"/>

        <!-- 상태 -->
        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2">

            <TextBlock
                Text="현재 상태"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10"
                MinHeight="60">

                <TextBlock
                    x:Name="txtStatus"
                    Text="이름을 입력하세요."
                    TextWrapping="Wrap"/>

            </Border>

        </StackPanel>

        <!-- 버튼 -->
        <StackPanel
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,25,0,0">

            <Button
                Content="등록"
                Tag="REGISTER"
                Width="90"
                Height="35"
                Margin="5"
                Click="ActionButton_Click"/>

            <Button
                Content="초기화"
                Tag="CLEAR"
                Width="90"
                Height="35"
                Margin="5"
                Click="ActionButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
