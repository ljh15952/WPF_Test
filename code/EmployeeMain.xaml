<Window x:Class="WpfBeginner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event 실습"
        Height="500"
        Width="700">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="社員管理"
            FontSize="30"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <DataGrid
            x:Name="dgEmployees"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True">

            <DataGrid.Columns>
                
                <DataGridTextColumn
                    Header="ID"
                    Binding="{Binding Id}"
                    Width="80"/>
                
                <DataGridTextColumn
                    Header="名前"
                    Binding="{Binding Name}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="年齢"
                    Binding="{Binding Age}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="部署"
                    Binding="{Binding Department}"
                    Width="120"/>

            </DataGrid.Columns>
            
        </DataGrid>

        <Button
            Grid.Row="2"
            Content="社員登録"
            Width="100"
            Height="30"
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            Click="RegisterEmployee_Click"/>

    </Grid>

</Window>
